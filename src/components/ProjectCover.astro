---
import ResponsiveImage from "./ResponsiveImage.astro";
import ruuwear from "../assets/projects/ruuwear.png";
import workloader from "../assets/projects/workloader.png";
import flowstock from "../assets/projects/Flowstock Screenshots/admin/03-dashboard.png";

interface Props {
  motif: "wear" | "work" | "stock";
  index?: string;
  priority?: boolean;
  loading?: "eager" | "lazy";
  sizes?: string;
}

const {
  motif,
  index,
  priority = false,
  loading,
  sizes = "(max-width: 980px) calc(100vw - 2rem), 560px",
} = Astro.props;

const cover = motif === "wear" ? ruuwear : motif === "work" ? workloader : flowstock;
---

<div class="cover" data-motif={motif}>
  <ResponsiveImage
    src={cover}
    alt=""
    widths={[160, 480, 800, 1200]}
    sizes={sizes}
    quality={90}
    avifQuality={68}
    priority={priority}
    loading={loading}
  />
  {index && <span class="cover__index">{index}</span>}
</div>

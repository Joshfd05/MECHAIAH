---
interface Props {
  motif: "wear" | "work" | "stock";
  index?: string;
}

const { motif, index } = Astro.props;
---

<div class="cover" data-motif={motif}>
  {
    motif === "wear" && (
      <svg viewBox="0 0 640 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="640" height="420" fill="#0B2B26" />
        <path d="M-20 230c130-150 250-90 360-130 120-44 210 20 320-30v350H-20Z" fill="#163832" />
        <path d="M-20 300c150-110 240-20 360-70 130-54 190 30 320-20v210H-20Z" fill="#235347" />
        <path
          d="M70 70c90 130 30 210-20 300"
          fill="none"
          stroke="#8EB69B"
          stroke-width="14"
          stroke-linecap="round"
        />
        <circle cx="486" cy="128" r="54" fill="#8EB69B" />
        <circle cx="486" cy="128" r="18" fill="#051F20" />
      </svg>
    )
  }
  {
    motif === "work" && (
      <svg viewBox="0 0 640 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="640" height="420" fill="#051F20" />
        <g fill="#163832">
          <rect x="70" y="78" width="250" height="42" rx="21" />
          <rect x="70" y="140" width="190" height="42" rx="21" />
          <rect x="70" y="264" width="280" height="42" rx="21" />
          <rect x="360" y="202" width="210" height="42" rx="21" />
        </g>
        <g fill="#235347">
          <rect x="70" y="202" width="220" height="42" rx="21" />
          <rect x="300" y="78" width="180" height="42" rx="21" />
          <rect x="300" y="326" width="240" height="42" rx="21" />
        </g>
        <rect x="300" y="140" width="270" height="42" rx="21" fill="#8EB69B" />
        <circle cx="318" cy="161" r="7" fill="#051F20" />
      </svg>
    )
  }
  {
    motif === "stock" && (
      <svg viewBox="0 0 640 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="640" height="420" fill="#0B2B26" />
        <path
          d="M96 300C150 300 170 150 250 146c86-4 96 150 176 146 74-4 90-150 150-120"
          fill="none"
          stroke="#DAF1DD"
          stroke-width="8"
          stroke-linecap="round"
        />
        <g fill="#235347">
          <circle cx="96" cy="110" r="16" />
          <circle cx="176" cy="110" r="16" />
          <circle cx="336" cy="110" r="16" />
          <circle cx="496" cy="110" r="16" />
          <circle cx="176" cy="210" r="16" />
          <circle cx="416" cy="210" r="16" />
          <circle cx="96" cy="310" r="16" />
          <circle cx="336" cy="310" r="16" />
          <circle cx="496" cy="310" r="16" />
        </g>
        <g fill="#8EB69B">
          <circle cx="96" cy="300" r="22" />
          <circle cx="250" cy="146" r="22" />
          <circle cx="426" cy="292" r="22" />
          <circle cx="572" cy="172" r="22" />
        </g>
      </svg>
    )
  }
  {index && <span class="cover__index">{index}</span>}
</div>

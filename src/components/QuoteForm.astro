---
import { budgets, site, streams, timelines } from "../data/site";

const key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
const redirectTo = new URL("/contact?sent=1", Astro.url.origin).href;
const sent = Astro.url.searchParams.get("sent") === "1";
---

<form
  class="quote-form"
  id="quote-form"
  method="POST"
  action={key ? "https://api.web3forms.com/submit" : undefined}
  data-key={key}
  data-email={site.email}
  novalidate
>
  {
    key && (
      <>
        <input type="hidden" name="access_key" value={key} />
        <input type="hidden" name="subject" value="Quotation request — Mechaiah" />
        <input type="hidden" name="from_name" value="Mechaiah website" />
        <input type="hidden" name="redirect" value={redirectTo} />
      </>
    )
  }
  <div class="hp" inert>
    <label>
      Leave this empty
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <p class="form-status" id="form-status" role="status" data-status>
    {sent ? "Request received. You will get a reply with questions or a quote." : ""}
  </p>

  <div class="form-grid">
    <label class="field">
      <span>Name</span>
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label class="field">
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label class="field">
      <span>Company (optional)</span>
      <input name="company" type="text" autocomplete="organization" />
    </label>
    <label class="field">
      <span>What do you need</span>
      <select name="service" required>
        <option value="" selected disabled>Choose one</option>
        {streams.map((stream) => <option value={stream}>{stream}</option>)}
      </select>
    </label>
    <label class="field field--wide">
      <span>About the work</span>
      <textarea
        name="message"
        required
        placeholder="The site, the system, or the problem you want solved."
      ></textarea>
    </label>
    <label class="field">
      <span>Timeline</span>
      <select name="timeline" required>
        <option value="" selected disabled>Choose one</option>
        {timelines.map((item) => <option value={item}>{item}</option>)}
      </select>
    </label>
    <label class="field">
      <span>Budget range (optional)</span>
      <select name="budget">
        {budgets.map((item) => <option value={item}>{item}</option>)}
      </select>
    </label>
  </div>

  <p class="form-note">
    {
      key
        ? `Requests are sent to ${site.email}. You will get a reply with questions or a quote.`
        : `The form host is not connected yet. Until it is, email ${site.email} with the same details.`
    }
  </p>
  <button class="btn" type="submit">
    Request a quotation
    <span class="btn__orb" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="14" height="14">
        <path
          d="M3 8h10M9 4l4 4-4 4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("#quote-form");
  const status = form?.querySelector<HTMLElement>("[data-status]");
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !status) return;

    const required = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("[required]")];
    required.forEach((field) => field.removeAttribute("aria-invalid"));

    if (!form.checkValidity()) {
      required.forEach((field) => {
        if (!field.validity.valid) field.setAttribute("aria-invalid", "true");
      });
      status.textContent = "Add the missing fields before sending. Name, email, the kind of work, a short description, and a timeline are required.";
      const firstInvalid = required.find((field) => !field.validity.valid);
      firstInvalid?.focus();
      return;
    }

    const key = form.dataset.key ?? "";
    const email = form.dataset.email ?? "";
    if (!key) {
      status.textContent = `This form is not connected to an inbox yet. Email ${email} with the same details and you will get a reply.`;
      return;
    }

    if (submit) submit.disabled = true;
    status.textContent = "Sending…";

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: new FormData(form),
      });
      const result = (await response.json()) as { success?: boolean };
      if (result.success) {
        form.reset();
        status.textContent = "Request received. You will get a reply with questions or a quote.";
      } else {
        status.textContent = `The request did not send. Email ${email} and you will get a reply.`;
      }
    } catch {
      status.textContent = `The request did not send. Email ${email} and you will get a reply.`;
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>

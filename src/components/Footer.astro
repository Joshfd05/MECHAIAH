---
import { nav, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div>
    <a class="footer__logo" href="/" aria-label={site.name}>
      <img src="/brand/logo-on-dark.png" alt="" width="176" height="113" />
    </a>
    <p class="footer__line">Websites and custom software, scoped and handed over.</p>
  </div>
  <nav class="footer__nav" aria-label="Footer">
    {
      nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
  </nav>
  <div>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <nav class="footer__social" aria-label="Social">
      {
        site.socials.map((item) => (
          <a href={item.href} target="_blank" rel="noopener noreferrer">
            {item.label}
          </a>
        ))
      }
    </nav>
    <p class="footer__meta">© {year}</p>
  </div>
</footer>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectFan from "../../components/ProjectFan.astro";
import { comingSoon } from "../../data/site";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Selected work from Mechaiah: FlowStock and Workloader. RuuWear is coming soon at ruuwear.lk."
>
  <header class="page-head">
    <p class="kicker">Projects</p>
    <h1>Breathing work.</h1>
    <p class="lede">
      Explore the projects we've brought to life for our clients. Dive deeper into each idea behind each project and how they were built.
    </p>
  </header>
  <ProjectFan projects={projects} />
  <p class="coming-note">
    {comingSoon.name} is coming soon at<a href={comingSoon.href}>{comingSoon.label}</a>.
  </p>
</BaseLayout>

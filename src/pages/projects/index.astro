---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectFan from "../../components/ProjectFan.astro";
import { getProjects } from "../../lib/projects";

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Selected work from Mechaiah: RuuWear, Workloader, and FlowStock."
>
  <header class="page-head">
    <p class="kicker">Projects</p>
    <h1>Selected work.</h1>
    <p class="lede">
      Explore the projects we've brought to life for our clients. Dive deeper into each idea behind each project and how they were built.
    </p>
  </header>
  <ProjectFan projects={projects} />
</BaseLayout>

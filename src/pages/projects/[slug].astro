---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCover from "../../components/ProjectCover.astro";
import { getProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const projects = await getProjects();
const index = projects.findIndex((item) => item.data.slug === project.data.slug);
const previous = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const position = String(index + 1).padStart(2, "0");
---

<BaseLayout
  title={project.data.title}
  description={`${project.data.title} is selected work from Mechaiah. ${project.data.summary}`}
>
  <header class="page-head">
    <p class="kicker">
      <a class="text-link" href="/projects">All projects</a>
    </p>
    <h1>{project.data.title}</h1>
    <p class="lede">{project.data.tagline}. {project.data.outcome}</p>
  </header>

  <div class="case-cover">
    <ProjectCover motif={project.data.motif} index={position} />
  </div>

  <div class="case-row">
    <h2>The problem</h2>
    <p>{project.data.problem}</p>
  </div>
  <div class="case-row">
    <h2>What was built</h2>
    <p>{project.data.built}</p>
  </div>
  <div class="case-row">
    <h2>Role</h2>
    <p>{project.data.role}. {project.data.summary}</p>
  </div>
  {
    project.data.stack.length > 0 && (
      <div class="case-row">
        <h2>Stack</h2>
        <ul class="stack-list">
          {project.data.stack.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
  {
    project.data.url && (
      <div class="case-row">
        <h2>Live</h2>
        <p>
          <a class="text-link" href={project.data.url}>
            Visit the live project
          </a>
        </p>
      </div>
    )
  }

  <nav class="pager" aria-label="Other projects">
    {
      previous && (
        <a href={`/projects/${previous.data.slug}`}>
          <span>Previous</span>
          <strong>{previous.data.title}</strong>
        </a>
      )
    }
    {
      next && (
        <a href={`/projects/${next.data.slug}`}>
          <span>Next</span>
          <strong>{next.data.title}</strong>
        </a>
      )
    }
  </nav>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCover from "../../components/ProjectCover.astro";
import ShotStack from "../../components/ShotStack.astro";
import { getProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project: routed } = Astro.props;
const projects = await getProjects();
const project = projects.find((item) => item.data.slug === routed.data.slug) ?? routed;
const shots = project.data.shots ?? [];
const index = projects.findIndex((item) => item.data.slug === project.data.slug);
const previous = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const position = String(index + 1).padStart(2, "0");

function paragraphs(text: string) {
  return text
    .split(/\n\s*\n/)
    .map((part) => part.trim())
    .filter(Boolean);
}
---

<BaseLayout
  title={project.data.title}
  description={`${project.data.title} is selected work from Mechaiah. ${project.data.summary}`}
>
  <header class="page-head">
    <p class="kicker">
      <a class="text-link" href="/projects">All projects</a>
    </p>
    <div class="case-title">
      {
        project.data.slug === "ruuwear" && (
          <span class="case-mark case-mark--wear">
            <img src="/projects/ruuwear-mark.png" alt="" width="1040" height="1040" />
          </span>
        )
      }
      {
        project.data.slug === "workloader" && (
          <span class="case-mark case-mark--work">
            <img src="/projects/workloader-mark.png" alt="" width="1040" height="1040" />
          </span>
        )
      }
      <h1>{project.data.title}</h1>
    </div>
    <p class="lede">{project.data.lede ?? `${project.data.tagline}. ${project.data.outcome}`}</p>
  </header>

  {
    project.data.slug !== "ruuwear" && project.data.slug !== "workloader" && (
      <div class="case-cover">
        <ProjectCover motif={project.data.motif} index={position} />
      </div>
    )
  }

  {
    (project.data.slug === "workloader" || project.data.slug === "ruuwear") && shots.length > 0 && (
      <ShotStack shots={shots} />
    )
  }
  {
    project.data.slug !== "workloader" && project.data.slug !== "ruuwear" && shots.length > 0 && (
      <div class="case-shots">
        {shots.map((shot) => (
          <figure>
            <img src={shot.src} alt={shot.alt} />
            <figcaption>{shot.label}</figcaption>
          </figure>
        ))}
      </div>
    )
  }

  <div class="case-row">
    <h2>The problem</h2>
    <div>
      {paragraphs(project.data.problem).map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
  <div class="case-row">
    <h2>What was built</h2>
    <div>
      {paragraphs(project.data.built).map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
  <div class="case-row">
    <h2>Role</h2>
    <p>{project.data.role}. {project.data.summary}</p>
  </div>
  {
    project.data.url && (
      <div class="case-row">
        <h2>Live</h2>
        <p>
          <a class="text-link" href={project.data.url}>
            Visit the live project
          </a>
        </p>
      </div>
    )
  }

  <nav class="pager" aria-label="Other projects">
    {
      previous && (
        <a href={`/projects/${previous.data.slug}`}>
          <span>Previous</span>
          <strong>{previous.data.title}</strong>
        </a>
      )
    }
    {
      next && (
        <a href={`/projects/${next.data.slug}`}>
          <span>Next</span>
          <strong>{next.data.title}</strong>
        </a>
      )
    }
  </nav>
</BaseLayout>

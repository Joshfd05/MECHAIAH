---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCover from "../../components/ProjectCover.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import ShotStack from "../../components/ShotStack.astro";
import ruuwearMark from "../../assets/projects/ruuwear-mark.png";
import workloaderMark from "../../assets/projects/workloader-mark.png";
import { projectImage } from "../../lib/project-images";
import { getProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project: routed } = Astro.props;
const projects = await getProjects();
const project = projects.find((item) => item.data.slug === routed.data.slug) ?? routed;
const shots = project.data.shots ?? [];
const index = projects.findIndex((item) => item.data.slug === project.data.slug);
const previous = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const position = String(index + 1).padStart(2, "0");

function paragraphs(text: string) {
  return text
    .split(/\n\s*\n/)
    .map((part) => part.trim())
    .filter(Boolean);
}
---

<BaseLayout
  title={project.data.title}
  description={`${project.data.title} is selected work from Mechaiah. ${project.data.summary}`}
>
  <header class="page-head">
    <p class="kicker">
      <a class="text-link" href="/projects">All projects</a>
    </p>
    <div class="case-title">
      {
        project.data.slug === "ruuwear" && (
          <span class="case-mark case-mark--wear">
            <ResponsiveImage
              src={ruuwearMark}
              alt=""
              widths={[128, 256, 384]}
              sizes="(max-width: 720px) 14vw, 102px"
              quality={90}
              avifQuality={68}
              loading="eager"
            />
          </span>
        )
      }
      {
        project.data.slug === "workloader" && (
          <span class="case-mark case-mark--work">
            <ResponsiveImage
              src={workloaderMark}
              alt=""
              widths={[128, 256, 384]}
              sizes="(max-width: 720px) 14vw, 102px"
              quality={90}
              avifQuality={68}
              loading="eager"
            />
          </span>
        )
      }
      <h1>{project.data.title}</h1>
    </div>
    <p class="lede">{project.data.lede ?? `${project.data.tagline}. ${project.data.outcome}`}</p>
  </header>

  {
    project.data.slug !== "ruuwear" && project.data.slug !== "workloader" && (
      <div class="case-cover">
        <ProjectCover motif={project.data.motif} index={position} />
      </div>
    )
  }

  {
    (project.data.slug === "workloader" || project.data.slug === "ruuwear") && shots.length > 0 && (
      <ShotStack shots={shots} />
    )
  }
  {
    project.data.slug !== "workloader" && project.data.slug !== "ruuwear" && shots.length > 0 && (
      <div class="case-shots">
        {shots.map((shot, index) => (
          <figure>
            <ResponsiveImage
              src={projectImage(shot.src)}
              alt={shot.alt}
              widths={[640, 960, 1440]}
              sizes="(max-width: 720px) 92vw, min(1120px, 92vw)"
              quality={85}
              avifQuality={62}
              priority={index === 0}
              lightbox
            />
            <figcaption>{shot.label}</figcaption>
          </figure>
        ))}
      </div>
    )
  }

  <div class="case-row">
    <h2>The problem</h2>
    <div>
      {paragraphs(project.data.problem).map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
  <div class="case-row">
    <h2>What was built</h2>
    <div>
      {paragraphs(project.data.built).map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
  <div class="case-row">
    <h2>Role</h2>
    <p>{project.data.role}. {project.data.summary}</p>
  </div>
  {
    project.data.url && (
      <div class="case-row">
        <h2>{project.data.urlLabel ? "Launch" : "Live"}</h2>
        <p>
          <a class="text-link" href={project.data.url}>
            {project.data.urlLabel ?? "Visit the live project"}
          </a>
        </p>
      </div>
    )
  }

  <nav class="pager" aria-label="Other projects">
    {
      previous.data.slug !== next.data.slug ? (
        <>
          <a href={`/projects/${previous.data.slug}`}>
            <span>Previous</span>
            <strong>{previous.data.title}</strong>
          </a>
          <a href={`/projects/${next.data.slug}`}>
            <span>Next</span>
            <strong>{next.data.title}</strong>
          </a>
        </>
      ) : previous.data.slug !== project.data.slug ? (
        <a href={`/projects/${next.data.slug}`}>
          <span>Other project</span>
          <strong>{next.data.title}</strong>
        </a>
      ) : null
    }
  </nav>
</BaseLayout>

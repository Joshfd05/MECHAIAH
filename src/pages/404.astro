---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page is not on the Mechaiah site.">
  <header class="page-head">
    <p class="kicker">404</p>
    <h1>This page is not here.</h1>
    <p class="lede">The link may be old. The work lives on the home page, the projects, and the quotation form.</p>
    <a class="btn" href="/">
      Back home
      <span class="btn__orb" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14">
          <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>
  </header>
</BaseLayout>

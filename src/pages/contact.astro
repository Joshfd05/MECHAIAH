---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { quoteSteps, site, gmailTo } from "../data/site";
---

<BaseLayout
  title="Contact"
  description="Request a quotation from Mechaiah for a website or custom software."
>
  <div class="contact-layout">
    <header class="page-head">
      <p class="kicker">Contact</p>
      <h1>Request a quotation.</h1>
      <p class="lede">
        Tell us what you need built. The reply is a few questions, or a quote.
      </p>
      <ol class="steps">
        {
          quoteSteps.map((step, i) => (
            <li>
              <b>0{i + 1}</b>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
    </header>
    <div>
      <QuoteForm />
      <p class="direct-mail">
        Or write directly to <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </div>
</BaseLayout>
